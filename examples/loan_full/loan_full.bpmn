      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_XOR_join_di" bpmnElement="Gateway_XOR_join" isMarkerVisible="true">
        <dc:Bounds x="1275" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approval_di" bpmnElement="Task_Approval">
        <dc:Bounds x="1400" y="60" width="100" height="80" />
