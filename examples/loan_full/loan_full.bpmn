<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_loan_full" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="loan_full" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Application received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Upload" name="Upload documents">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KYC" name="KYC check">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AND_split" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Scoring" name="Credit scoring">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Fraud" name="Fraud check">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_AND_join" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_XOR_split" name="Risk level">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AutoApprove" name="Auto approval">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ManualReview" name="Manual review">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_XOR_join" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Approval" name="Approval">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Decision sent">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Upload" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Upload" targetRef="Task_KYC" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_KYC" targetRef="Gateway_AND_split" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_AND_split" targetRef="Task_Scoring" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_AND_split" targetRef="Task_Fraud" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Scoring" targetRef="Gateway_AND_join" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Fraud" targetRef="Gateway_AND_join" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gateway_AND_join" targetRef="Gateway_XOR_split" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_XOR_split" targetRef="Task_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_XOR_split" targetRef="Task_ManualReview" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AutoApprove" targetRef="Gateway_XOR_join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ManualReview" targetRef="Gateway_XOR_join" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_XOR_join" targetRef="Task_Approval" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Approval" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_loan_full">
    <bpmndi:BPMNPlane id="BPMNPlane_loan_full" bpmnElement="loan_full">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
